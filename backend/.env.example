# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - GAVAC (EJEMPLO LOCAL)
# ==============================================================================

# Clave secreta para JWT (usa una cadena aleatoria segura)
AUTH_SECRET_KEY=cambia-esta-clave-secreta-para-produccion

# Creación automática de tablas en desarrollo (true/false)
AUTO_CREATE_TABLES=true

# Orígenes permitidos para CORS (separados por comas)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8010,http://127.0.0.1:8010

# Configuración de Cookies seguras (true para HTTPS en producción, false para local)
COOKIE_SECURE=false

# URL de conexión a la base de datos local (Docker / PostgreSQL)
# Formato: postgresql://[usuario]:[contraseña]@[host]:[puerto]/[nombre_bd]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gavac_db